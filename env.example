# Linear API Key - obtener desde https://linear.app/settings/account/security
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxx

# ID del proyecto de Linear (se puede obtener con el script: npx tsx scripts/fetch-linear-data.ts --list-projects)
LINEAR_PROJECT_ID=12fde5cf-06c4-xxxx-xxxx-xxxxxxxxxxxx

# (Opcional) ID del equipo - si no se especifica, se obtiene del proyecto
LINEAR_TEAM_ID=
